# Copy this file to .env and fill in real values for local/production deployments.
# NEVER commit real secrets (API keys, passwords) to git; leave placeholders here.
# Use "your-<service>-<type>-here" format to document what value is expected.
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
REDIS_URL=redis://127.0.0.1:6379
DRIVER_PII_ENCRYPTION_KEY=your-pii-encryption-key-here (32-byte or Fernet token)
DRIVER_DOCUMENT_MAX_UPLOAD_BYTES=8388608
DRIVER_DOCUMENT_MALWARE_SCAN_ENABLED=False
DEFAULT_FROM_EMAIL=no-reply@rideguarde.com
SOS_SMS_PROVIDER=console
SOS_SMS_HTTP_ENDPOINT=
SOS_SMS_HTTP_AUTH_TOKEN=
SOS_SMS_HTTP_SENDER_ID=Rideguarde
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=no-reply@rideguarde.com
ADMIN_NOTIFICATION_EMAILS=admin@rideguarde.com
